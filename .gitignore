# Generated artefacts. Every one is rebuilt from a published seed by the generator beside it,
# so the repository carries the generators and the ground-truth schemas, not their output.
# See each dataset's README for the command that reproduces it byte for byte.

# Rendered and degraded documents (messy-scan): ~2.1 GB
datasets/messy-scan/documents/
datasets/messy-scan/build/
datasets/messy-scan/sample/
datasets/messy-scan/private/
datasets/messy-scan/ground-truth.jsonl
datasets/messy-scan/manifest.json

# Synthesised audio and generated scenarios (honest-containment)
datasets/honest-containment/audio/
datasets/honest-containment/private/
datasets/honest-containment/transcripts/
datasets/honest-containment/scenarios.jsonl
datasets/honest-containment/audio-manifest.jsonl
datasets/honest-containment/manifest.json

# Generated items (exception-economics)
datasets/exception-economics/ground-truth.jsonl
datasets/exception-economics/sample/
datasets/exception-economics/manifest.json

# Build output and caches
site/node_modules/
site/.next/
site/out/
site/*.tsbuildinfo
harness/src/*.egg-info/
**/__pycache__/
**/.pytest_cache/
*.pyc
.venv/

# QA screenshots: regenerate with the site's screenshot script. Summaries live in site/qa/README.md.
site/qa/*.png

# Generated binaries. Each is built by the script beside it; sizes and hashes are in
